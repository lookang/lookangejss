<Code><![CDATA[
double dx=-xmin/(nx-1),dy=(xmax-xmin)/(ny-1);
for(int i=0;i<nx;i++){
 for(int j=0;j<ny;j++){
   E[i][j][0]=xmin+i*dx;
   E2[i][j][0]=-E[i][j][0];
   E2[i][j][1]=E[i][j][1]=ymin+j*dy;
 }
}
dragp();
]]></Code>

