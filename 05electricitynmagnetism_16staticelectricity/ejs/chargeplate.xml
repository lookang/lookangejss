<Osejs.Model.Library.Page>
<Type>LIBRARY_EDITOR</Type>
<Name>dragp</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
double c,dc=Math.PI*2/np;
public void dragp () {
if(x1>-size)x1=-size;
for(int i=0;i<np;i++){
 c=i*dc;
 X[i]=x1+size1*Math.cos(c);
 Y[i]=y1+size1*Math.sin(c);
 done[i]=false;
}
SC=0;
_view.getElement("TraceSet").reset();
}
]]></Code>

</Content>
