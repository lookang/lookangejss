Options -Indexes

# Hide hidden files inside uploaded content folders.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Uploaded content should never execute server-side scripts from this directory.
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|exe|bat|cmd|ps1)$">
    Require all denied
</FilesMatch>
