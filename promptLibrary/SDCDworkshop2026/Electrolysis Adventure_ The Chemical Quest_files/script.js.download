// ===== GAME STATE MANAGEMENT =====
// Core game state object tracking progress, score, and current stage
const gameState = {
    score: 0,
    currentStage: 0,
    totalStages: 5,
    playerChoices: [],
    currentAnswers: {}
};

// ===== AUDIO SYSTEM =====
// Web Audio API for generating musical score and sound effects
const audioContext = new (window.AudioContext || window.webkitAudioContext)();

// Background music generator - creates ambient atmospheric tones
let backgroundMusic = null;
let musicGainNode = null;

function initBackgroundMusic() {
    // Create oscillators for layered ambient music
    musicGainNode = audioContext.createGain();
    musicGainNode.gain.value = 0.1; // Low volume for background
    musicGainNode.connect(audioContext.destination);
    
    // Base tone
    const osc1 = audioContext.createOscillator();
    osc1.type = 'sine';
    osc1.frequency.value = 110; // A2
    
    // Harmonic layer
    const osc2 = audioContext.createOscillator();
    osc2.type = 'sine';
    osc2.frequency.value = 165; // E3
    
    osc1.connect(musicGainNode);
    osc2.connect(musicGainNode);
    
    osc1.start();
    osc2.start();
    
    backgroundMusic = { osc1, osc2 };
}

// Sound effect for correct answers - pleasant ascending tones
function playCorrectSound() {
    const now = audioContext.currentTime;
    const osc = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    osc.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    osc.frequency.setValueAtTime(523.25, now); // C5
    osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
    osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
    
    gainNode.gain.setValueAtTime(0.3, now);
    gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
    
    osc.start(now);
    osc.stop(now + 0.5);
}

// Sound effect for incorrect answers - descending tone
function playIncorrectSound() {
    const now = audioContext.currentTime;
    const osc = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    osc.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    osc.frequency.setValueAtTime(400, now);
    osc.frequency.setValueAtTime(200, now + 0.3);
    
    gainNode.gain.setValueAtTime(0.3, now);
    gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
    
    osc.start(now);
    osc.stop(now + 0.4);
}

// Click sound for interactions
function playClickSound() {
    const now = audioContext.currentTime;
    const osc = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    osc.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    osc.frequency.value = 800;
    gainNode.gain.setValueAtTime(0.2, now);
    gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
    
    osc.start(now);
    osc.stop(now + 0.1);
}

