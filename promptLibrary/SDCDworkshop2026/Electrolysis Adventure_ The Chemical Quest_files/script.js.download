// ===== DOM ELEMENTS =====
const elements = {
    storyPanel: document.getElementById('story-panel'),
    gamePanel: document.getElementById('game-panel'),
    feedbackPanel: document.getElementById('feedback-panel'),
    storyText: document.getElementById('story-text'),
    choicesContainer: document.getElementById('choices-container'),
    challengeDescription: document.getElementById('challenge-description'),
    draggableItems: document.getElementById('draggable-items'),
    anodeDrop: document.getElementById('anode-drop'),
    cathodeDrop: document.getElementById('cathode-drop'),
    electrolyteDrop: document.getElementById('electrolyte-drop'),
    submitBtn: document.getElementById('submit-btn'),
    feedbackText: document.getElementById('feedback-text'),
    continueBtn: document.getElementById('continue-btn'),
    scoreValue: document.getElementById('score-value'),
    progressFill: document.getElementById('progress-fill'),
    tooltip: document.getElementById('tooltip')
};

// ===== TOOLTIP SYSTEM =====
// Shows informative tooltips on hover without taking vertical space
function showTooltip(text) {
    elements.tooltip.textContent = text;
    elements.tooltip.classList.add('show');
}

function hideTooltip() {
    elements.tooltip.classList.remove('show');
}

// Add hover listeners for elements with title attributes
document.addEventListener('mouseover', (e) => {
    if (e.target.hasAttribute('title')) {
        showTooltip(e.target.getAttribute('title'));
    }
});

document.addEventListener('mouseout', (e) => {
    if (e.target.hasAttribute('title')) {
        hideTooltip();
    }
});

// ===== DRAG AND DROP SYSTEM =====
// Implements intuitive drag-and-drop mechanics for electrolysis setup
let draggedElement = null;
let draggedData = null;

function createDraggableItem(text, index) {
    const item = document.createElement('div');
    item.className = 'draggable-item';
    item.textContent = text;
    item.draggable = true;
    item.dataset.value = text;
    item.dataset.index = index;
    
    // Touch and mouse support
    item.addEventListener('dragstart', handleDragStart);
    item.addEventListener('dragend', handleDragEnd);
    
    // Touch events for mobile
    item.addEventListener('touchstart', handleTouchStart, { passive: false });
    item.addEventListener('touchmove', handleTouchMove, { passive: false });
    item.addEventListener('touchend', handleTouchEnd);
    
    return item;
}

function handleDragStart(e) {
    draggedElement = e.target;
    draggedData = e.target.dataset.value;
    e.target.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/html', e.target.innerHTML);
    playClickSound();
}

function handleDragEnd(e) {
    e.target.classList.remove('dragging');
    draggedElement = null;
}

// Touch support for mobile devices
let touchStartX, touchStartY;
let clonedElement = null;

function handleTouchStart(e) {
    e.preventDefault();
    draggedElement = e.target;
    draggedData = e.target.dataset.value;
    
    const touch = e.touches[0];
    touchStartX = touch.clientX;
    touchStartY = touch.clientY;
    
    // Create visual clone for dragging
    clonedElement = e.target.cloneNode(true);
    clonedElement.style.position = 'fixed';
    clonedElement.style.zIndex = '1000';
    clonedElement.style.pointerEvents = 'none';
    clonedElement.style.opacity = '0.8';
    document.body.appendChild(clonedElement);
    
    e.target.classList.add('dragging');
    playClickSound();
}

function handleTouchMove(e) {
    e.preventDefault();
    if (!clonedElement) return;
    
    const touch = e.touches[0];
    clonedElement.style.left = touch.clientX - 50 + 'px';
    clonedElement.style.top = touch.clientY - 20 + 'px';
}

function handleTouchEnd(e) {
    e.preventDefault();
    if (clonedElement) {
        document.body.removeChild(clonedElement);
        clonedElement = null;
    }
    
    if (draggedElement) {
        draggedElement.classList.remove('dragging');
        
        // Find drop zone under touch point
        const touch = e.changedTouches[0];
        const dropZone = document.elementFromPoint(touch.clientX, touch.clientY);
        
        if (dropZone && dropZone.classList.contains('drop-zone')) {
            handleDrop({ target: dropZone, preventDefault: () => {} });
        }
        
        draggedElement = null;
        draggedData = null;
    }
}

// Drop zone event handlers
function setupDropZones() {
    const dropZones = document.querySelectorAll('.drop-zone');
    
    dropZones.forEach(zone => {
        zone.addEventListener('dragover', handleDragOver);
        zone.addEventListener('dragleave', handleDragLeave);
        zone.addEventListener('drop', handleDrop);
        
        // Allow clicking to remove items
        zone.addEventListener('click', handleDropZoneClick);
    });
}

function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    e.target.classList.add('drag-over');
}

function handleDragLeave(e) {
    e.target.classList.remove('drag-over');
}

function handleDrop(e) {
    e.preventDefault();
    const dropZone = e.target.closest('.drop-zone');
    if (!dropZone) return;
    
    dropZone.classList.remove('drag-over');
    
    if (draggedData) {
        // Clear previous content
        dropZone.innerHTML = '';
        
        // Create placed item
        const placedItem = document.createElement('div');
        placedItem.className = 'draggable-item placed';
        placedItem.textContent = draggedData;
        placedItem.dataset.value = draggedData;
        dropZone.appendChild(placedItem);
        dropZone.classList.add('filled');
        
        // Store answer
        const zoneId = dropZone.id;
        if (zoneId === 'anode-drop') {
            gameState.currentAnswers.anode = draggedData;
        } else if (zoneId === 'cathode-drop') {
            gameState.currentAnswers.cathode = draggedData;
        } else if (zoneId === 'electrolyte-drop') {
            gameState.currentAnswers.electrolyte = draggedData;
        }
        
        // Mark original as placed
        if (draggedElement && !draggedElement.classList.contains('placed')) {
            draggedElement.style.opacity = '0.3';
            draggedElement.draggable = false;
        }
        
        playClickSound();
    }
}

function handleDropZoneClick(e) {
    const dropZone = e.target.closest('.drop-zone');
    if (!dropZone || !dropZone.classList.contains('filled')) return;
    
    // Remove item from drop zone
    const removedValue = dropZone.querySelector('.draggable-item')?.dataset.value;
    dropZone.innerHTML = '';
    dropZone.classList.remove('filled');
    
    // Clear from answers
    const zoneId = dropZone.id;
    if (zoneId === 'anode-drop') {
        delete gameState.currentAnswers.anode;
    } else if (zoneId === 'cathode-drop') {
        delete gameState.currentAnswers.cathode;
    } else if (zoneId === 'electrolyte-drop') {
        delete gameState.currentAnswers.electrolyte;
    }
    
    // Re-enable original draggable item
    const originalItem = Array.from(elements.draggableItems.children).find(
        item => item.dataset.value === removedValue
    );
    if (originalItem) {
        originalItem.style.opacity = '1';
        originalItem.draggable = true;
    }
    
    playClickSound();
}

// ===== GAME FLOW CONTROL =====
// Manages progression through story and challenges
function showStage(stageIndex) {
    if (stageIndex >= storyData.length) {
        stageIndex = storyData.length - 1;
    }
    
    gameState.currentStage = stageIndex;
    updateProgress();
    
    const stage = storyData[stageIndex];
    
    // Hide all panels
    elements.storyPanel.classList.add('hidden');
    elements.gamePanel.classList.add('hidden');
    elements.feedbackPanel.classList.add('hidden');
    
    if (stage.type === 'story') {
        showStory(stage);
    } else if (stage.type === 'challenge') {
        showChallenge(stage);
    }
}

function showStory(stage) {
    elements.storyPanel.classList.remove('hidden');
    elements.storyText.textContent = stage.text;
    
    // Clear and populate choices
    elements.choicesContainer.innerHTML = '';
    stage.choices.forEach(choice => {
        const btn = document.createElement('button');
        btn.className = 'choice-btn';
        btn.textContent = choice.text;
        btn.addEventListener('click', () => {
            playClickSound();
            if (choice.restart) {
                restartGame();
            } else {
                showStage(choice.next);
            }
        });
        elements.choicesContainer.appendChild(btn);
    });
}

function showChallenge(stage) {
    elements.gamePanel.classList.remove('hidden');
    elements.challengeDescription.textContent = stage.text;
    
    // Reset answers
    gameState.currentAnswers = {};
    
    // Clear drop zones
    elements.anodeDrop.innerHTML = '';
    elements.cathodeDrop.innerHTML = '';
    elements.electrolyteDrop.innerHTML = '';
    elements.anodeDrop.classList.remove('filled');
    elements.cathodeDrop.classList.remove('filled');
    elements.electrolyteDrop.classList.remove('filled');
    
    // Populate draggable options
    elements.draggableItems.innerHTML = '';
    stage.challenge.options.forEach((option, index) => {
        const item = createDraggableItem(option, index);
        elements.draggableItems.appendChild(item);
    });
    
    setupDropZones();
}

// ===== ANSWER CHECKING =====
// Validates student responses and provides immediate feedback
function checkAnswer() {
    const stage = storyData[gameState.currentStage];
    const correct = stage.challenge.correctAnswers;
    const student = gameState.currentAnswers;
    
    // Check if all required fields are filled
    if (!student.anode || !student.cathode || !student.electrolyte) {
        showTooltip('Please fill all drop zones before submitting!');
        setTimeout(hideTooltip, 2000);
        return;
    }
    
    // Check correctness
    const isCorrect = 
        student.anode === correct.anode &&
        student.cathode === correct.cathode &&
        student.electrolyte === correct.electrolyte;
    
    showFeedback(isCorrect, stage);
}

function showFeedback(isCorrect, stage) {
    elements.gamePanel.classList.add('hidden');
    elements.feedbackPanel.classList.remove('hidden');
    
    elements.feedbackText.classList.remove('correct', 'incorrect');
    
    if (isCorrect) {
        elements.feedbackText.classList.add('correct');
        elements.feedbackText.textContent = stage.correctFeedback;
        gameState.score += stage.points;
        updateScore();
        playCorrectSound();
        elements.feedbackPanel.classList.add('pulse');
    } else {
        elements.feedbackText.classList.add('incorrect');
        elements.feedbackText.textContent = stage.incorrectFeedback;
        playIncorrectSound();
        elements.feedbackPanel.classList.add('shake');
    }
    
    // Remove animation classes
    setTimeout(() => {
        elements.feedbackPanel.classList.remove('pulse', 'shake');
    }, 500);
}

// ===== UI UPDATES =====
function updateScore() {
    elements.scoreValue.textContent = gameState.score;
    elements.scoreDisplay.classList.add('pulse');
    setTimeout(() => {
        elements.scoreDisplay.classList.remove('pulse');
    }, 500);
}

function updateProgress() {
    const progress = (gameState.currentStage / (storyData.length - 1)) * 100;
    elements.progressFill.style.width = progress + '%';
}

function restartGame() {
    gameState.score = 0;
    gameState.currentStage = 0;
    gameState.currentAnswers = {};
    updateScore();
    updateProgress();
    showStage(0);
}

// ===== EVENT LISTENERS =====
elements.submitBtn.addEventListener('click', () => {
    playClickSound();
    checkAnswer();
});

elements.continueBtn.addEventListener('click', () => {
    playClickSound();
    const stage = storyData[gameState.currentStage];
    showStage(stage.next);
});

// ===== INITIALIZATION =====
// Start the game when page loads
document.addEventListener('DOMContentLoaded', () => {
    // Initialize audio on first user interaction (browser requirement)
    document.addEventListener('click', () => {
        if (audioContext.state === 'suspended') {
            audioContext.resume();
        }
        if (!backgroundMusic) {
            initBackgroundMusic();
        }
    }, { once: true });
    
    // Start game
    showStage(0);
    updateScore();
    updateProgress();
});