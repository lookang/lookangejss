// Fire Safety Detective Adventure - Interactive Learning Game
// This game teaches students about fire classifications through matching and sorting

// ============================================================================
// GAME DATA AND CONFIGURATION
// ============================================================================

// Fire classification data with Singapore curriculum alignment
const fireClassifications = {
    A: {
        icon: '🪵',
        title: 'Class A',
        description: 'Ordinary combustibles',
        color: '#4CAF50',
        examples: [
            { icon: '🪵', label: 'Wood' },
            { icon: '📄', label: 'Paper' },
            { icon: '🧵', label: 'Cloth' },
            { icon: '🗑️', label: 'Trash' },
            { icon: '🌾', label: 'Straw' }
        ]
    },
    B: {
        icon: '⛽',
        title: 'Class B',
        description: 'Flammable liquids',
        color: '#FF9800',
        examples: [
            { icon: '⛽', label: 'Petrol' },
            { icon: '🛢️', label: 'Oil' },
            { icon: '🎨', label: 'Paint' },
            { icon: '🧴', label: 'Alcohol' },
            { icon: '💅', label: 'Nail Polish' }
        ]
    },
    C: {
        icon: '⚡',
        title: 'Class C',
        description: 'Electrical equipment',
        color: '#2196F3',
        examples: [
            { icon: '💻', label: 'Computer' },
            { icon: '🔌', label: 'Wiring' },
            { icon: '📺', label: 'TV' },
            { icon: '🔋', label: 'Battery' },
            { icon: '💡', label: 'Light' }
        ]
    },
    D: {
        icon: '🔩',
        title: 'Class D',
        description: 'Combustible metals',
        color: '#9C27B0',
        examples: [
            { icon: '🔩', label: 'Magnesium' },
            { icon: '⚙️', label: 'Titanium' },
            { icon: '🪙', label: 'Sodium' },
            { icon: '🔧', label: 'Potassium' },
            { icon: '⚗️', label: 'Lithium' }
        ]
    },
    K: {
        icon: '🍳',
        title: 'Class K',
        description: 'Cooking oils/fats',
        color: '#F44336',
        examples: [
            { icon: '🍳', label: 'Cooking Oil' },
            { icon: '🥓', label: 'Animal Fat' },
            { icon: '🧈', label: 'Butter' },
            { icon: '🥘', label: 'Grease' },
            { icon: '🍔', label: 'Deep Fryer' }
        ]
    }
};

// Story progression data
const storyDialogues = [
    {
        character: '🚒',
        text: "Welcome, Junior Fire Safety Detective! I'm Captain Blaze, and we need your help! A mysterious fire incident has occurred in our town, and we need to classify different fire types to respond correctly. Are you ready for this important mission?",
        mission: "Learn about fire classifications and match incidents to their correct types!"
    },
    {
        character: '🔍',
        text: "Great work, Detective! You're learning fast! Remember, different fires need different extinguishing methods. Matching the right classification helps firefighters respond safely and effectively. Let's continue investigating!",
        mission: "Keep matching fire incidents to their correct classifications!"
    },
    {
        character: '🎖️',
        text: "Excellent detective work! You've mastered fire classifications! This knowledge can save lives. Always remember: knowing the type of fire helps us choose the right way to put it out safely. Mission accomplished!",
        mission: "Complete your final classifications to finish the mission!"
    }
];

// ============================================================================
// GAME STATE MANAGEMENT
// ============================================================================

let gameState = {
    currentStoryIndex: 0,
    score: 0,
    matchedItems: 0,
    totalItems: 0,
    timeRemaining: 60,
    timerInterval: null,
    startTime: null,
    currentCards: [],
    soundEnabled: true
};

// ============================================================================
// AUDIO SYSTEM
// ============================================================================

// Create audio context for sound effects using Web Audio API
const AudioSystem = {
    context: null,
    
    // Initialize audio context
    init() {
        try {
            this.context = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) {
            console.log('Web Audio API not supported');
        }
    },
    
    // Play a tone for correct answer
    playCorrect() {
        if (!this.context || !gameState.soundEnabled) return;
        
        const oscillator = this.context.createOscillator();
        const gainNode = this.context.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(this.context.destination);
        
        oscillator.frequency.value = 523.25; // C5
        oscillator.type = 'sine';
        
        gainNode.gain.setValueAtTime(0.3, this.context.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, this.context.currentTime + 0.3);
        
        oscillator.start(this.context.currentTime);
        oscillator.stop(this.context.currentTime + 0.3);
    },
    
    // Play a tone for incorrect answer
    playIncorrect() {
        if (!this.context || !gameState.soundEnabled) return;
        
        const oscillator = this.context.createOscillator();
        const gainNode = this.context.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(this.context.destination);
        
        oscillator.frequency.value = 200; // Lower tone
        oscillator.type = 'sawtooth';
        
        gainNode.gain.setValueAtTime(0.2, this.context.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, this.context.currentTime + 0.2);
        
        oscillator.start(this.context.currentTime);
        oscillator.stop(this.context.currentTime + 0.2);
    },
    
    // Play a tone for general interaction
    playClick() {
        if (!this.context || !gameState.soundEnabled) return;
        
        const oscillator = this.context.createOscillator();
        const gainNode = this.context.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(this.context.destination);
        
        oscillator.frequency.value = 800;
        oscillator.type = 'sine';
        
        gainNode.gain.setValueAtTime(0.1, this.context.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, this.context.currentTime + 0.1);
        
        oscillator.start(this.context.currentTime);
        oscillator.stop(this.context.currentTime + 0.1);
    },
    
    // Play success melody
    playSuccess() {
        if (!this.context || !gameState.soundEnabled) return;
        
        const notes = [523.25, 587.33, 659.25, 783.99]; // C, D, E, G
        notes.forEach((freq, index) => {
            const oscillator = this.context.createOscillator();
            const gainNode = this.context.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(this.context.destination);
            
            oscillator.frequency.value = freq;
            oscillator.type = 'sine';
            
            const startTime = this.context.currentTime + (index * 0.15);
            gainNode.gain.setValueAtTime(0.2, startTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, startTime + 0.3);
            
            oscillator.start(startTime);
            oscillator.stop(startTime + 0.3);
        });
    }
};

// ============================================================================
// DOM ELEMENTS
// ============================================================================

let elements = {};

// ============================================================================
// INITIALIZATION
// ============================================================================

// Initialize the application when DOM is loaded
document.addEventListener('DOMContentLoaded', () => {
    // Check if running in standalone mode (not in iframe)
    if (window.self === window.top) {
        document.body.classList.add('standalone');
    }
    
    // Cache DOM elements
    cacheElements();
    
    // Initialize audio system
    AudioSystem.init();
    
    // Set up event listeners
    setupEventListeners();
    
    // Start the story
    showStory();
});

// Cache all DOM elements for better performance
function cacheElements() {
    elements = {
        storyBox: document.getElementById('story-box'),
        characterAvatar: document.getElementById('character-avatar'),
        dialogueText: document.getElementById('dialogue-text'),
        continueBtn: document.getElementById('continue-btn'),
        gameArea: document.getElementById('game-area'),
        missionText: document.getElementById('mission-text'),
        fireCards: document.getElementById('fire-cards'),
        dropZones: document.getElementById('drop-zones'),
        score: document.getElementById('score'),
        timer: document.getElementById('timer'),
        progress: document.getElementById('progress'),
        feedbackPanel: document.getElementById('feedback-panel'),
        feedbackIcon: document.getElementById('feedback-icon'),
        feedbackText: document.getElementById('feedback-text'),
        endScreen: document.getElementById('end-screen'),
        endIcon: document.getElementById('end-icon'),
        endTitle: document.getElementById('end-title'),
        endMessage: document.getElementById('end-message'),
        finalScore: document.getElementById('final-score'),
        finalProgress: document.getElementById('final-progress'),
        timeUsed: document.getElementById('time-used'),
        restartBtn: document.getElementById('restart-btn'),
        centerTooltip: document.getElementById('center-tooltip')
    };
}

// Set up all event listeners
function setupEventListeners() {
    elements.continueBtn.addEventListener('click', handleContinue);
    elements.restartBtn.addEventListener('click', restartGame);
    
    // Add tooltip functionality for status items
    document.querySelectorAll('.status-item').forEach(item => {
        item.addEventListener('mouseenter', (e) => {
            showTooltip(e.target.getAttribute('title'));
        });
        item.addEventListener('mouseleave', hideTooltip);
    });
}

// ============================================================================
// STORY SYSTEM
// ============================================================================

// Display story dialogue
function showStory() {
    const story = storyDialogues[gameState.currentStoryIndex];
    
    elements.characterAvatar.textContent = story.character;
    elements.dialogueText.textContent = story.text;
    
    elements.storyBox.classList.remove('hidden');
    elements.gameArea.classList.add('hidden');
    elements.endScreen.classList.add('hidden');
    
    AudioSystem.playClick();
}

// Handle continue button click
function handleContinue() {
    AudioSystem.playClick();
    
    if (gameState.currentStoryIndex === 0) {
        // First time - start the game
        startGame();
    } else if (gameState.currentStoryIndex < storyDialogues.length - 1) {
        // Continue to next story segment
        gameState.currentStoryIndex++;
        startGame();
    } else {
        // Final story - show end screen
        showEndScreen();
    }
}

// ============================================================================
// GAME LOGIC
// ============================================================================

// Start or continue the game
function startGame() {
    elements.storyBox.classList.add('hidden');
    elements.gameArea.classList.remove('hidden');
    
    // Set mission text
    const story = storyDialogues[gameState.currentStoryIndex];
    elements.missionText.textContent = story.mission;
    
    // Initialize game if first time
    if (gameState.currentStoryIndex === 0) {
        gameState.score = 0;
        gameState.matchedItems = 0;
        gameState.startTime = Date.now();
        gameState.timeRemaining = 60;
        startTimer();
    }
    
    // Generate new cards and zones
    generateGameContent();
    updateUI();
}

// Generate fire cards and drop zones
function generateGameContent() {
    // Clear existing content
    elements.fireCards.innerHTML = '';
    elements.dropZones.innerHTML = '';
    
    // Determine which classifications to use based on story progress
    const classKeys = Object.keys(fireClassifications);
    const numClasses = Math.min(3 + gameState.currentStoryIndex, 5);
    const selectedClasses = classKeys.slice(0, numClasses);
    
    // Create drop zones
    selectedClasses.forEach(classKey => {
        const classData = fireClassifications[classKey];
        const zone = createDropZone(classKey, classData);
        elements.dropZones.appendChild(zone);
    });
    
    // Create fire cards (1-2 examples from each class)
    gameState.currentCards = [];
    selectedClasses.forEach(classKey => {
        const classData = fireClassifications[classKey];
        const numExamples = 1 + Math.floor(Math.random() * 2); // 1 or 2 examples
        
        // Shuffle and select examples
        const shuffled = [...classData.examples].sort(() => Math.random() - 0.5);
        const selected = shuffled.slice(0, numExamples);
        
        selected.forEach(example => {
            const card = createFireCard(example, classKey);
            gameState.currentCards.push({ element: card, correctClass: classKey });
            elements.fireCards.appendChild(card);
        });
    });
    
    // Shuffle cards
    const cardsArray = Array.from(elements.fireCards.children);
    cardsArray.sort(() => Math.random() - 0.5);
    cardsArray.forEach(card => elements.fireCards.appendChild(card));
    
    // Update total items
    gameState.totalItems = gameState.matchedItems + gameState.currentCards.length;
}

// Create a fire card element
function createFireCard(example, classKey) {
    const card = document.createElement('div');
    card.className = 'fire-card';
    card.draggable = true;
    card.dataset.class = classKey;
    
    const icon = document.createElement('div');
    icon.className = 'card-icon';
    icon.textContent = example.icon;
    
    const label = document.createElement('div');
    label.className = 'card-label';
    label.textContent = example.label;
    
    card.appendChild(icon);
    card.appendChild(label);
    
    // Add drag event listeners
    card.addEventListener('dragstart', handleDragStart);
    card.addEventListener('dragend', handleDragEnd);
    
    // Add touch event listeners for mobile
    card.addEventListener('touchstart', handleTouchStart, { passive: false });
    card.addEventListener('touchmove', handleTouchMove, { passive: false });
    card.addEventListener('touchend', handleTouchEnd);
    
    // Add click sound
    card.addEventListener('mousedown', () => AudioSystem.playClick());
    
    return card;
}

// Create a drop zone element
function createDropZone(classKey, classData) {
    const zone = document.createElement('div');
    zone.className = 'drop-zone';
    zone.dataset.class = classKey;
    
    const header = document.createElement('div');
    header.className = 'zone-header';
    header.textContent = classData.icon;
    
    const title = document.createElement('div');
    title.className = 'zone-title';
    title.textContent = classData.title;
    
    const description = document.createElement('div');
    description.className = 'zone-description';
    description.textContent = classData.description;
    
    const itemsContainer = document.createElement('div');
    itemsContainer.className = 'zone-items';
    
    zone.appendChild(header);
    zone.appendChild(title);
    zone.appendChild(description);
    zone.appendChild(itemsContainer);
    
    // Add drop event listeners
    zone.addEventListener('dragover', handleDragOver);
    zone.addEventListener('dragleave', handleDragLeave);
    zone.addEventListener('drop', handleDrop);
    
    // Add tooltip on hover
    zone.addEventListener('mouseenter', () => {
        const info = `${classData.title}: ${classData.description}`;
        showTooltip(info);
    });
    zone.addEventListener('mouseleave', hideTooltip);
    
    return zone;
}

// ============================================================================
// DRAG AND DROP HANDLERS
// ============================================================================

let draggedElement = null;

function handleDragStart(e) {
    draggedElement = e.target;
    e.target.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/html', e.target.innerHTML);
}

function handleDragEnd(e) {
    e.target.classList.remove('dragging');
}

function handleDragOver(e) {
    if (e.preventDefault) {
        e.preventDefault();
    }
    e.dataTransfer.dropEffect = 'move';
    e.currentTarget.classList.add('drag-over');
    return false;
}

function handleDragLeave(e) {
    e.currentTarget.classList.remove('drag-over');
}

function handleDrop(e) {
    if (e.stopPropagation) {
        e.stopPropagation();
    }
    e.preventDefault();
    
    const dropZone = e.currentTarget;
    dropZone.classList.remove('drag-over');
    
    if (draggedElement) {
        checkMatch(draggedElement, dropZone);
    }
    
    return false;
}

// ============================================================================
// TOUCH HANDLERS FOR MOBILE
// ============================================================================

let touchedElement = null;
let touchClone = null;

function handleTouchStart(e) {
    touchedElement = e.currentTarget;
    AudioSystem.playClick();
    
    // Create a clone for visual feedback
    touchClone = touchedElement.cloneNode(true);
    touchClone.style.position = 'fixed';
    touchClone.style.pointerEvents = 'none';
    touchClone.style.opacity = '0.8';
    touchClone.style.zIndex = '1000';
    document.body.appendChild(touchClone);
    
    const touch = e.touches[0];
    touchClone.style.left = touch.clientX - 50 + 'px';
    touchClone.style.top = touch.clientY - 50 + 'px';
}

function handleTouchMove(e) {
    e.preventDefault();
    
    if (!touchClone) return;
    
    const touch = e.touches[0];
    touchClone.style.left = touch.clientX - 50 + 'px';
    touchClone.style.top = touch.clientY - 50 + 'px';
}

function handleTouchEnd(e) {
    if (!touchClone) return;
    
    const touch = e.changedTouches[0];
    const dropTarget = document.elementFromPoint(touch.clientX, touch.clientY);
    
    // Find the drop zone
    let dropZone = dropTarget;
    while (dropZone && !dropZone.classList.contains('drop-zone')) {
        dropZone = dropZone.parentElement;
    }
    
    if (dropZone && touchedElement) {
        checkMatch(touchedElement, dropZone);
    }
    
    // Clean up
    document.body.removeChild(touchClone);
    touchClone = null;
    touchedElement = null;
}

// ============================================================================
// MATCH CHECKING AND FEEDBACK
// ============================================================================

// Check if the card matches the drop zone
function checkMatch(card, zone) {
    const cardClass = card.dataset.class;
    const zoneClass = zone.dataset.class;
    
    if (cardClass === zoneClass) {
        // Correct match
        handleCorrectMatch(card, zone);
    } else {
        // Incorrect match
        handleIncorrectMatch(card, zone);
    }
}

// Handle correct match
function handleCorrectMatch(card, zone) {
    AudioSystem.playCorrect();
    
    // Add points
    const points = 100 + (gameState.timeRemaining * 2);
    gameState.score += points;
    gameState.matchedItems++;
    
    // Move card icon to zone
    const itemsContainer = zone.querySelector('.zone-items');
    const zoneItem = document.createElement('div');
    zoneItem.className = 'zone-item';
    zoneItem.textContent = card.querySelector('.card-icon').textContent;
    itemsContainer.appendChild(zoneItem);
    
    // Mark card as matched
    card.classList.add('matched');
    
    // Show feedback
    showFeedback('✅', `Correct! +${points} points`, 'success');
    
    // Update UI
    updateUI();
    
    // Check if level complete
    if (gameState.matchedItems === gameState.totalItems) {
        setTimeout(() => {
            completeLevel();
        }, 1500);
    }
}

// Handle incorrect match
function handleIncorrectMatch(card, zone) {
    AudioSystem.playIncorrect();
    
    // Deduct points
    gameState.score = Math.max(0, gameState.score - 20);
    
    // Get correct class info
    const correctClass = fireClassifications[card.dataset.class];
    const attemptedClass = fireClassifications[zone.dataset.class];
    
    // Show feedback
    showFeedback('❌', `Not quite! This belongs to ${correctClass.title} (${correctClass.description}), not ${attemptedClass.title}`, 'error');
    
    // Shake animation
    card.style.animation = 'none';
    setTimeout(() => {
        card.style.animation = '';
    }, 10);
    
    updateUI();
}

// Show feedback message
function showFeedback(icon, text, type) {
    elements.feedbackIcon.textContent = icon;
    elements.feedbackText.textContent = text;
    elements.feedbackPanel.classList.remove('hidden');
    
    setTimeout(() => {
        elements.feedbackPanel.classList.add('hidden');
    }, 2500);
}

// ============================================================================
// TIMER SYSTEM
// ============================================================================

// Start the countdown timer
function startTimer() {
    if (gameState.timerInterval) {
        clearInterval(gameState.timerInterval);
    }
    
    gameState.timerInterval = setInterval(() => {
        gameState.timeRemaining--;
        updateUI();
        
        if (gameState.timeRemaining <= 0) {
            clearInterval(gameState.timerInterval);
            gameOver();
        }
    }, 1000);
}

// ============================================================================
// UI UPDATES
// ============================================================================

// Update all UI elements
function updateUI() {
    elements.score.textContent = gameState.score;
    elements.timer.textContent = gameState.timeRemaining;
    elements.progress.textContent = `${gameState.matchedItems}/${gameState.totalItems}`;
}

// Show tooltip at center
function showTooltip(text) {
    elements.centerTooltip.textContent = text;
    elements.centerTooltip.classList.remove('hidden');
}

// Hide tooltip
function hideTooltip() {
    elements.centerTooltip.classList.add('hidden');
}

// ============================================================================
// LEVEL COMPLETION
// ============================================================================

// Complete current level
function completeLevel() {
    AudioSystem.playSuccess();
    
    // Bonus points for remaining time
    const timeBonus = gameState.timeRemaining * 10;
    gameState.score += timeBonus;
    
    showFeedback('🎉', `Level Complete! Time Bonus: +${timeBonus} points!`, 'success');
    
    // Move to next story
    gameState.currentStoryIndex++;
    
    // Reset timer for next level
    gameState.timeRemaining = 60;
    
    setTimeout(() => {
        if (gameState.currentStoryIndex < storyDialogues.length) {
            showStory();
        } else {
            showEndScreen();
        }
    }, 2500);
}

// ============================================================================
// GAME OVER
// ============================================================================

// Handle game over (time ran out)
function gameOver() {
    clearInterval(gameState.timerInterval);
    
    elements.endIcon.textContent = '⏰';
    elements.endTitle.textContent = 'Time\'s Up!';
    elements.endMessage.textContent = 'You ran out of time, but you learned a lot about fire safety! Every detective needs practice. Try again to improve your score!';
    
    const timeUsed = Math.floor((Date.now() - gameState.startTime) / 1000);
    
    elements.finalScore.textContent = gameState.score;
    elements.finalProgress.textContent = `${gameState.matchedItems}/${gameState.totalItems}`;
    elements.timeUsed.textContent = timeUsed + 's';
    
    elements.gameArea.classList.add('hidden');
    elements.endScreen.classList.remove('hidden');
}

// Show end screen (mission complete)
function showEndScreen() {
    clearInterval(gameState.timerInterval);
    
    AudioSystem.playSuccess();
    
    elements.endIcon.textContent = '🏆';
    elements.endTitle.textContent = 'Mission Complete!';
    elements.endMessage.textContent = 'Congratulations, Fire Safety Detective! You\'ve successfully learned all fire classifications and can now help keep your community safe. You\'re a true hero!';
    
    const timeUsed = Math.floor((Date.now() - gameState.startTime) / 1000);
    
    elements.finalScore.textContent = gameState.score;
    elements.finalProgress.textContent = `${gameState.matchedItems}/${gameState.totalItems}`;
    elements.timeUsed.textContent = timeUsed + 's';
    
    elements.gameArea.classList.add('hidden');
    elements.storyBox.classList.add('hidden');
    elements.endScreen.classList.remove('hidden');
}

// ============================================================================
// RESTART GAME
// ============================================================================

// Restart the entire game
function restartGame() {
    AudioSystem.playClick();
    
    // Reset game state
    gameState = {
        currentStoryIndex: 0,
        score: 0,
        matchedItems: 0,
        totalItems: 0,
        timeRemaining: 60,
        timerInterval: null,
        startTime: null,
        currentCards: [],
        soundEnabled: true
    };
    
    // Clear intervals
    if (gameState.timerInterval) {
        clearInterval(gameState.timerInterval);
    }
    
    // Show first story
    showStory();
}