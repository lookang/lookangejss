// ===== AUDIO CONTEXT =====
// Using Web Audio API to generate simple tones for music and sound effects
// This works offline without external audio files
let audioContext;
let backgroundMusicNode;
let musicGainNode;

// Initialize audio context (must be done after user interaction)
function initAudio() {
    if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        musicGainNode = audioContext.createGain();
        musicGainNode.connect(audioContext.destination);
        musicGainNode.gain.value = 0.1; // Low volume for background music
    }
}

// Generate background music using oscillators
function playBackgroundMusic() {
    if (!gameState.musicEnabled || !audioContext) return;
    
    stopBackgroundMusic();
    
    // Create a simple melody using multiple oscillators
    const notes = [261.63, 293.66, 329.63, 349.23, 392.00]; // C, D, E, F, G
    let noteIndex = 0;
    
    function playNote() {
        if (!gameState.musicEnabled) return;
        
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(musicGainNode);
        
        oscillator.type = 'sine';
        oscillator.frequency.value = notes[noteIndex % notes.length];
        
        gainNode.gain.setValueAtTime(0.05, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
        
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.5);
        
        noteIndex++;
        
        backgroundMusicNode = setTimeout(playNote, 600);
    }
    
    playNote();
}

function stopBackgroundMusic() {
    if (backgroundMusicNode) {
        clearTimeout(backgroundMusicNode);
        backgroundMusicNode = null;
    }
}

// Play sound effect for button clicks and interactions
function playSoundEffect(type) {
    if (!gameState.sfxEnabled || !audioContext) return;
    
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    // Different sounds for different interactions
    switch(type) {
        case 'click':
            oscillator.frequency.value = 800;
            oscillator.type = 'square';
            gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.1);
            break;
        case 'success':
            oscillator.frequency.value = 523.25; // C5
            oscillator.type = 'sine';
            gainNode.gain.setValueAtTime(0.2, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.3);
            break;
        case 'danger':
            oscillator.frequency.value = 200;
            oscillator.type = 'sawtooth';
            gainNode.gain.setValueAtTime(0.15, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.2);
            break;
    }
}

// ===== TIMER MANAGEMENT =====
function startTimer() {
    // Clear any existing timer
    if (gameState.timerInterval) {
        clearInterval(gameState.timerInterval);
    }
    
    // Start countdown timer
    gameState.timerInterval = setInterval(() => {
        gameState.timeRemaining--;
        updateTimerDisplay();
        
        // Warning state when time is low
        const timerContainer = document.getElementById('timer-container');
        if (gameState.timeRemaining <= 60) {
            timerContainer.classList.add('warning');
        }
        
        // Game over when time runs out
        if (gameState.timeRemaining <= 0) {
            clearInterval(gameState.timerInterval);
            endGame(false);
        }
    }, 1000);
}

function updateTimerDisplay() {
    const minutes = Math.floor(gameState.timeRemaining / 60);
    const seconds = gameState.timeRemaining % 60;
    const timerText = document.getElementById('timer-text');
    timerText.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
}

function stopTimer() {
    if (gameState.timerInterval) {
        clearInterval(gameState.timerInterval);
        gameState.timerInterval = null;
    }
}

// ===== PROGRESS TRACKING =====
function updateProgress() {
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    
    // Calculate progress based on current chapter
    const totalChapters = 9;
    const progress = (gameState.currentChapter / totalChapters) * 100;
    
    progressFill.style.width = `${progress}%`;
    progressText.textContent = `Chapter ${gameState.currentChapter + 1} of ${totalChapters}`;
}

// ===== STORY DISPLAY WITH TYPING EFFECT =====
function displayStory(chapterIndex) {
    const chapter = storyData[chapterIndex];
    const storyText = document.getElementById('story-text');
    const characterAvatar = document.getElementById('character-avatar');
    const choicesContainer = document.getElementById('choices-container');
    
    // Update character state
    characterAvatar.className = chapter.characterState;
    
    // Clear previous content
    storyText.textContent = '';
    choicesContainer.innerHTML = '';
    
    // Typing effect for story text (cognitive load management - progressive disclosure)
    let charIndex = 0;
    const text = chapter.text;
    const typingSpeed = 30; // milliseconds per character
    
    function typeCharacter() {
        if (charIndex < text.length) {
            storyText.textContent += text.charAt(charIndex);
            charIndex++;
            setTimeout(typeCharacter, typingSpeed);
        } else {
            // Show choices after text is fully displayed
            if (chapter.choices.length > 0) {
                displayChoices(chapter.choices);
            } else {
                // Final chapter - show completion
                setTimeout(() => endGame(true), 2000);
            }
        }
    }
    
    typeCharacter();
    
    // Update progress
    updateProgress();
}

// ===== DISPLAY CHOICES =====
function displayChoices(choices) {
    const choicesContainer = document.getElementById('choices-container');
    choicesContainer.innerHTML = '';
    
    choices.forEach((choice, index) => {
        const button = document.createElement('button');
        button.className = 'choice-btn fade-in';
        button.textContent = choice.text;
        button.style.animationDelay = `${index * 0.1}s`;
        
        // Add tooltip for longer text (Mayer's principle: manage complexity)
        button.addEventListener('mouseenter', (e) => {
            if (choice.text.length > 60) {
                showTooltip(choice.text, e);
            }
        });
        
        button.addEventListener('mouseleave', hideTooltip);
        
        // Handle choice selection
        button.addEventListener('click', () => {
            playSoundEffect('click');
            handleChoice(choice);
        });
        
        choicesContainer.appendChild(button);
    });
}

// ===== HANDLE PLAYER CHOICE =====
function handleChoice(choice) {
    // Record choice
    gameState.playerChoices.push(choice);
    
    // Store lesson learned
    if (choice.lesson) {
        gameState.lessonsLearned.push(choice.lesson);
    }
    
    // Update score based on outcome
    if (choice.outcome === 'safe') {
        gameState.score += 10;
        playSoundEffect('success');
    } else {
        gameState.score -= 5;
        playSoundEffect('danger');
    }
    
    // Show feedback
    showFeedback(choice.feedback, choice.outcome);
    
    // Move to next chapter after feedback
    setTimeout(() => {
        gameState.currentChapter = choice.nextChapter;
        displayStory(gameState.currentChapter);
    }, 3000);
}

// ===== SHOW FEEDBACK =====
function showFeedback(feedback, outcome) {
    const storyPanel = document.getElementById('story-panel');
    const feedbackDiv = document.createElement('div');
    feedbackDiv.className = 'fade-in';
    feedbackDiv.style.marginTop = '15px';
    feedbackDiv.style.padding = '15px';
    feedbackDiv.style.borderRadius = '10px';
    feedbackDiv.style.fontWeight = 'bold';
    
    if (outcome === 'safe') {
        feedbackDiv.style.background = 'linear-gradient(135deg, #A8E6CF, #95E1D3)';
        feedbackDiv.style.border = '3px solid #95E1D3';
        feedbackDiv.innerHTML = `✅ ${feedback}`;
    } else {
        feedbackDiv.style.background = 'linear-gradient(135deg, #FFB6B6, #FF6B6B)';
        feedbackDiv.style.border = '3px solid #FF6B6B';
        feedbackDiv.innerHTML = `⚠️ ${feedback}`;
    }
    
    storyPanel.appendChild(feedbackDiv);
    
    // Scroll to show feedback
    storyPanel.scrollTop = storyPanel.scrollHeight;
}

// ===== TOOLTIP MANAGEMENT =====
function showTooltip(text, event) {
    const tooltip = document.getElementById('info-tooltip');
    tooltip.textContent = text;
    tooltip.classList.remove('hidden');
    tooltip.classList.add('visible');
}

function hideTooltip() {
    const tooltip = document.getElementById('info-tooltip');
    tooltip.classList.remove('visible');
    setTimeout(() => {
        tooltip.classList.add('hidden');
    }, 300);
}

// ===== END GAME =====
function endGame(completed) {
    stopTimer();
    stopBackgroundMusic();
    
    const gameOverScreen = document.getElementById('game-over-screen');
    const gameOverTitle = document.getElementById('game-over-title');
    const gameOverMessage = document.getElementById('game-over-message');
    const lessonsLearnedDiv = document.getElementById('lessons-learned');
    
    gameOverScreen.classList.remove('hidden');
    
    if (completed) {
        gameOverTitle.textContent = '🎉 Mission Complete!';
        gameOverMessage.innerHTML = `
            <p>Congratulations, Detective Alex! You've successfully completed your investigation.</p>
            <p><strong>Final Score: ${gameState.score} points</strong></p>
            <p>Time Remaining: ${Math.floor(gameState.timeRemaining / 60)}:${(gameState.timeRemaining % 60).toString().padStart(2, '0')}</p>
        `;
        playSoundEffect('success');
    } else {
        gameOverTitle.textContent = '⏰ Time\'s Up!';
        gameOverMessage.innerHTML = `
            <p>The investigation took too long, but you've still learned valuable lessons!</p>
            <p><strong>Final Score: ${gameState.score} points</strong></p>
        `;
    }
    
    // Display lessons learned
    if (gameState.lessonsLearned.length > 0) {
        lessonsLearnedDiv.innerHTML = `
            <h3>🎓 Key Lessons Learned:</h3>
            <ul>
                ${gameState.lessonsLearned.map(lesson => `<li>${lesson}</li>`).join('')}
            </ul>
        `;
    }
}

// ===== RESTART GAME =====
function restartGame() {
    // Reset game state
    gameState.currentChapter = 0;
    gameState.score = 0;
    gameState.timeRemaining = 300;
    gameState.playerChoices = [];
    gameState.lessonsLearned = [];
    
    // Hide game over screen
    document.getElementById('game-over-screen').classList.add('hidden');
    
    // Reset timer display
    const timerContainer = document.getElementById('timer-container');
    timerContainer.classList.remove('warning');
    updateTimerDisplay();
    
    // Start new game
    startGame();
}

// ===== SOUND CONTROLS =====
function toggleMusic() {
    gameState.musicEnabled = !gameState.musicEnabled;
    const musicBtn = document.getElementById('music-toggle');
    
    if (gameState.musicEnabled) {
        musicBtn.classList.remove('muted');
        playBackgroundMusic();
    } else {
        musicBtn.classList.add('muted');
        stopBackgroundMusic();
    }
    
    playSoundEffect('click');
}

function toggleSFX() {
    gameState.sfxEnabled = !gameState.sfxEnabled;
    const sfxBtn = document.getElementById('sfx-toggle');
    
    if (gameState.sfxEnabled) {
        sfxBtn.classList.remove('muted');
    } else {
        sfxBtn.classList.add('muted');
    }
    
    playSoundEffect('click');
}

// ===== DETECT IFRAME OR STANDALONE =====
function detectEnvironment() {
    // Check if running in iframe or standalone
    if (window.self !== window.top) {
        // In iframe - use 450px height
        document.body.style.height = '450px';
    } else {
        // Standalone - use 90vh
        document.body.classList.add('standalone');
    }
}

// ===== START GAME =====
function startGame() {
    // Initialize audio on first user interaction
    initAudio();
    
    // Start background music
    playBackgroundMusic();
    
    // Start timer
    startTimer();
    
    // Display first chapter
    displayStory(gameState.currentChapter);
    
    // Show header tooltip briefly
    const headerTooltip = document.getElementById('header-tooltip');
    headerTooltip.style.opacity = '1';
    setTimeout(() => {
        headerTooltip.style.opacity = '0';
    }, 3000);
}

// ===== INITIALIZATION =====
document.addEventListener('DOMContentLoaded', () => {
    // Detect environment (iframe vs standalone)
    detectEnvironment();
    
    // Set up sound control buttons
    document.getElementById('music-toggle').addEventListener('click', toggleMusic);
    document.getElementById('sfx-toggle').addEventListener('click', toggleSFX);
    
    // Set up restart button
    document.getElementById('restart-btn').addEventListener('click', restartGame);
    
    // Start the game
    startGame();
});

// ===== ACCESSIBILITY AND TOUCH SUPPORT =====
// Ensure buttons work well with both mouse and touch
document.addEventListener('touchstart', function() {}, {passive: true});

// Prevent double-tap zoom on buttons (better mobile experience)
let lastTouchEnd = 0;
document.addEventListener('touchend', function(event) {
    const now = Date.now();
    if (now - lastTouchEnd <= 300) {
        event.preventDefault();
    }
    lastTouchEnd = now;
}, false);

// ===== KEYBOARD NAVIGATION SUPPORT =====
document.addEventListener('keydown', (e) => {
    const choices = document.querySelectorAll('.choice-btn');
    
    // Allow keyboard navigation through choices (1-4 keys)
    if (e.key >= '1' && e.key <= '4') {
        const index = parseInt(e.key) - 1;
        if (choices[index]) {
            choices[index].click();
        }
    }
    
    // Space or Enter to restart
    if ((e.key === ' ' || e.key === 'Enter') && !document.getElementById('game-over-screen').classList.contains('hidden')) {
        document.getElementById('restart-btn').click();
    }
});