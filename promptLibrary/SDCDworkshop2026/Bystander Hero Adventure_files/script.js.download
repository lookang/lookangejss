            { text: 'Ignore it and walk away', category: 'unhelpful', points: 0 }
        ],
        feedback: {
            helpful: '⭐ Excellent! Supporting Sarah and reporting bullying are both helpful actions. You showed empathy and courage!',
            unhelpful: '💭 Remember, ignoring bullying or joining in makes the person feel worse. A true hero stands up for others!'
        }
    },
    {
        id: 2,
        character: '😰',
        situation: 'During a Minecraft game session, you notice someone in the chat calling another player "noob" and "stupid" repeatedly.',
        responses: [
            { text: 'Send a private message to check if they\'re okay', category: 'helpful', points: 20 },
            { text: 'Type "stop being mean" in the chat', category: 'helpful', points: 20 },
            { text: 'Join in the teasing to be funny', category: 'unhelpful', points: 0 },
            { text: 'Keep playing and pretend nothing happened', category: 'unhelpful', points: 0 }
        ],
        feedback: {
            helpful: '🌟 Great choice! Speaking up against mean behaviour online and checking on others shows you\'re a digital hero!',
