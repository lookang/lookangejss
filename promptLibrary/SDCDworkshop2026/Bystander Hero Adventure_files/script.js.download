        responses: [
            { text: 'Suggest ways Alex can contribute to the project', category: 'helpful', points: 20 },
            { text: 'Agree with the leader to avoid conflict', category: 'unhelpful', points: 0 },
            { text: 'Offer to work with Alex as partners', category: 'helpful', points: 20 },
            { text: 'Stay quiet to not get involved', category: 'unhelpful', points: 0 }
        ],
        feedback: {
            helpful: '✨ Wonderful! Including everyone and finding solutions shows great leadership and kindness!',
