// ===== DEEPFAKE DETECTIVE - MAIN JAVASCRIPT =====
// This script handles the sorting game mechanics, audio, scoring, and narrative progression

// ===== AUDIO SYSTEM =====
// Create audio context for background music and sound effects
const AudioSystem = {
    context: null,
    backgroundMusic: null,
    
    // Initialize audio context (must be triggered by user interaction)
    init() {
        if (!this.context) {
            this.context = new (window.AudioContext || window.webkitAudioContext)();
        }
    },
    
    // Play background music using Web Audio API oscillators
    playBackgroundMusic() {
        this.init();
        if (this.backgroundMusic) return; // Already playing
        
        const ctx = this.context;
        const now = ctx.currentTime;
        
        // Create a mysterious, tension-building background track
        const oscillator1 = ctx.createOscillator();
        const oscillator2 = ctx.createOscillator();
        const gainNode = ctx.createGain();
        
        oscillator1.type = 'sine';
        oscillator2.type = 'triangle';
        oscillator1.frequency.setValueAtTime(110, now); // A2
        oscillator2.frequency.setValueAtTime(165, now); // E3
        
        gainNode.gain.setValueAtTime(0.05, now);
        
        oscillator1.connect(gainNode);
        oscillator2.connect(gainNode);
        gainNode.connect(ctx.destination);
        
        oscillator1.start(now);
        oscillator2.start(now);
        
        this.backgroundMusic = { oscillator1, oscillator2, gainNode };
    },
    
    // Play success sound effect
    playCorrectSound() {
        this.init();
        const ctx = this.context;
        const now = ctx.currentTime;
        
        const oscillator = ctx.createOscillator();
        const gainNode = ctx.createGain();
        
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(523.25, now); // C5
        oscillator.frequency.exponentialRampToValueAtTime(783.99, now + 0.1); // G5
        
        gainNode.gain.setValueAtTime(0.3, now);
        gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
        
        oscillator.connect(gainNode);
        gainNode.connect(ctx.destination);
        
        oscillator.start(now);
        oscillator.stop(now + 0.3);
    },
    
    // Play error sound effect
    playIncorrectSound() {
        this.init();
        const ctx = this.context;
        const now = ctx.currentTime;
        
        const oscillator = ctx.createOscillator();
        const gainNode = ctx.createGain();
        
        oscillator.type = 'sawtooth';
        oscillator.frequency.setValueAtTime(200, now);
        oscillator.frequency.exponentialRampToValueAtTime(100, now + 0.2);
        
        gainNode.gain.setValueAtTime(0.2, now);
        gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
        
        oscillator.connect(gainNode);
        gainNode.connect(ctx.destination);
        
        oscillator.start(now);
        oscillator.stop(now + 0.2);
    },
    
    // Stop background music
    stopBackgroundMusic() {
        if (this.backgroundMusic) {
            this.backgroundMusic.oscillator1.stop();
            this.backgroundMusic.oscillator2.stop();
            this.backgroundMusic = null;
        }
    }
};

// ===== GAME DATA =====
