// ===================================
// GAME STATE
// Tracks which animals have been found
// ===================================
let foundAnimals = new Set();
let analyticsLog = [];

// ===================================
// DOM ELEMENTS
// Cache frequently accessed elements
// ===================================
const animals = document.querySelectorAll('.animal');
const infoPanel = document.getElementById('infoPanel');
const closeBtn = document.getElementById('closeBtn');
const animalName = document.getElementById('animalName');
const animalImage = document.getElementById('animalImage');
const animalInfo = document.getElementById('animalInfo');
const foundCount = document.getElementById('foundCount');
const resetBtn = document.getElementById('resetBtn');
const analyticsToggle = document.getElementById('analyticsToggle');
const analyticsPanel = document.getElementById('analyticsPanel');
const analyticsContent = document.getElementById('analyticsContent');
const clearLogBtn = document.getElementById('clearLogBtn');

// ===================================
// INITIALIZATION
// Set up event listeners when page loads
// ===================================
function init() {
    // Add click/touch listeners to each animal
    animals.forEach(animal => {
        // Mouse events
        animal.addEventListener('click', handleAnimalClick);
        
        // Touch events for mobile
        animal.addEventListener('touchstart', handleTouchStart, { passive: false });
        
        // Keyboard accessibility
        animal.setAttribute('tabindex', '0');
        animal.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                handleAnimalClick(e);
            }
        });
    });
    
    // Close button listeners
    closeBtn.addEventListener('click', closeInfoPanel);
    closeBtn.addEventListener('touchstart', closeInfoPanel, { passive: true });
    
    // Reset button listeners
    resetBtn.addEventListener('click', resetGame);
    resetBtn.addEventListener('touchstart', resetGame, { passive: true });
    
    // Analytics toggle listeners
    analyticsToggle.addEventListener('click', toggleAnalytics);
    analyticsToggle.addEventListener('touchstart', toggleAnalytics, { passive: true });
    
    // Clear log button listeners
    clearLogBtn.addEventListener('click', clearAnalyticsLog);
    clearLogBtn.addEventListener('touchstart', clearAnalyticsLog, { passive: true });
    
    // Close info panel when clicking outside
    infoPanel.addEventListener('click', (e) => {
        if (e.target === infoPanel) {
            closeInfoPanel();
        }
    });
    
    // Update initial score
    updateScore();
}

// ===================================
// TOUCH EVENT HANDLING
// Prevent default behavior and handle touch
// ===================================
function handleTouchStart(e) {
    e.preventDefault(); // Prevent scrolling and default touch behavior
    handleAnimalClick(e);
}

// ===================================
// ANIMAL CLICK HANDLER
// Shows information panel when animal is clicked
// ===================================
function handleAnimalClick(e) {
    const animal = e.currentTarget;
    const animalType = animal.dataset.animal;
    const data = animalData[animalType];
    
    if (!data) return;
    
    // Mark animal as found
    if (!foundAnimals.has(animalType)) {
        foundAnimals.add(animalType);
        animal.classList.add('found');
        updateScore();
        
        // Log to analytics
        logAnimalDiscovery(animalType, data);
    }
    
    // Display information
    showAnimalInfo(data);
}

// ===================================
// SHOW ANIMAL INFORMATION
// Populates and displays the info panel
// ===================================
function showAnimalInfo(data) {
    animalName.textContent = data.name;
    animalImage.innerHTML = data.svg;
    
    // Build features list
    const featuresHTML = data.features.map(feature => 
        `<p>${feature}</p>`
    ).join('');
    
    animalInfo.innerHTML = featuresHTML;
    
    // Show panel with animation
    infoPanel.classList.add('active');
}

// ===================================
// CLOSE INFO PANEL
// Hides the information panel
// ===================================
function closeInfoPanel() {
    infoPanel.classList.remove('active');
}

// ===================================
// UPDATE SCORE DISPLAY
// Shows how many animals have been found
// ===================================
function updateScore() {
    const total = animals.length;
    const found = foundAnimals.size;
    foundCount.textContent = `${found}/${total}`;
    
    // Check if all animals found
    if (found === total) {
        setTimeout(() => {
            showCompletionMessage();
        }, 500);
    }
}

// ===================================
// COMPLETION MESSAGE
// Shows when all animals are found
// ===================================
function showCompletionMessage() {
    animalName.textContent = "🎉 Congratulations!";
    animalImage.innerHTML = `<div style="font-size: 60px;">🏆</div>`;
    animalInfo.innerHTML = `
        <p style="text-align: center; font-size: 18px;">
            <strong>Well done!</strong><br>
            You found all the animals in the park!<br><br>
            You learned about:<br>
            ✅ Smooth-Coated Otter<br>
            ✅ Malayan Water Monitor<br>
            ✅ Long-Tailed Shrike<br>
            ✅ Red Junglefowl<br><br>
            Click "Reset Game" to play again!
        </p>
    `;
    infoPanel.classList.add('active');
}

// ===================================
// RESET GAME
// Clears all progress and starts over
// ===================================
function resetGame() {
    // Clear found animals
    foundAnimals.clear();
    
    // Remove found class from all animals
    animals.forEach(animal => {
        animal.classList.remove('found');
    });
    
    // Close info panel
    closeInfoPanel();
    
    // Update score
    updateScore();
    
    // Note: Analytics log is preserved unless explicitly cleared
}

// ===================================
// ANALYTICS FUNCTIONS
// Track and display learning progress
// ===================================

function toggleAnalytics() {
    analyticsPanel.classList.toggle('active');
    analyticsToggle.classList.toggle('active');
    
    if (analyticsPanel.classList.contains('active')) {
        analyticsToggle.textContent = '📊 Hide Learning Analytics';
    } else {
        analyticsToggle.textContent = '📊 Show Learning Analytics';
    }
}

function logAnimalDiscovery(animalType, data) {
    const timestamp = new Date().toLocaleTimeString('en-SG', { 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit' 
    });
    
    const entry = {
        timestamp,
        animalType,
        animalName: data.name,
        features: data.features
    };
    
    analyticsLog.push(entry);
    updateAnalyticsDisplay();
}

function updateAnalyticsDisplay() {
    if (analyticsLog.length === 0) {
        analyticsContent.innerHTML = '<p class="analytics-empty">Click on animals to start tracking your learning journey!</p>';
        return;
    }
    
    const entriesHTML = analyticsLog.map((entry, index) => `
        <div class="analytics-entry">
            <span class="timestamp">⏰ ${entry.timestamp} - Discovery #${index + 1}</span>
            <div class="animal-name">🔍 Found: ${entry.animalName}</div>
            <div class="feature-list">
                ✅ Learned ${entry.features.length} unique features about this animal
            </div>
        </div>
    `).join('');
    
    analyticsContent.innerHTML = entriesHTML;
    
    // Auto-scroll to latest entry
    analyticsContent.scrollTop = analyticsContent.scrollHeight;
}

function clearAnalyticsLog() {
    if (confirm('Are you sure you want to clear the learning log?')) {
        analyticsLog = [];
        updateAnalyticsDisplay();
    }
}

// ===================================
// RESPONSIVE HANDLING
// Adjust layout based on screen size and orientation
// ===================================
function handleResize() {
    // Adjust animal sizes on very small screens
    if (window.innerWidth < 400) {
        animals.forEach(animal => {
            const svg = animal.querySelector('svg');
            if (svg) {
                const currentWidth = parseInt(svg.getAttribute('width'));
                svg.setAttribute('width', currentWidth * 0.8);
                svg.setAttribute('height', parseInt(svg.getAttribute('height')) * 0.8);
            }
        });
    }
}

// Debounce resize events for performance
let resizeTimeout;
window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(handleResize, 250);
});

// ===================================
// ORIENTATION CHANGE HANDLING
// Adjust layout when device orientation changes
// ===================================
window.addEventListener('orientationchange', () => {
    setTimeout(() => {
        handleResize();
    }, 100);
});

// ===================================
// PREVENT ACCIDENTAL NAVIGATION
// Warn before leaving if game is in progress
// ===================================
window.addEventListener('beforeunload', (e) => {
    if (foundAnimals.size > 0 && foundAnimals.size < animals.length) {
        e.preventDefault();
        e.returnValue = '';
    }
});

// ===================================
// START THE GAME
// Initialize when DOM is fully loaded
// ===================================
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
} else {
    init();
}

// ===================================
// ACCESSIBILITY: Screen Reader Support
// Announce when animals are found
// ===================================
function announceToScreenReader(message) {
    const announcement = document.createElement('div');
    announcement.setAttribute('role', 'status');
    announcement.setAttribute('aria-live', 'polite');
    announcement.className = 'sr-only';
    announcement.textContent = message;
    document.body.appendChild(announcement);
    
    setTimeout(() => {
        document.body.removeChild(announcement);
    }, 1000);
}

// Add screen reader only class
const style = document.createElement('style');
style.textContent = `
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }
`;
document.head.appendChild(style);