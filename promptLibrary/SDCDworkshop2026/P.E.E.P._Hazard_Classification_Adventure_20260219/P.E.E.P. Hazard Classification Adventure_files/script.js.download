// Audio context for sound effects (Web Audio API)
let audioContext;
let backgroundMusicGain;

// Initialize audio context
function initAudio() {
    try {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        backgroundMusicGain = audioContext.createGain();
        backgroundMusicGain.connect(audioContext.destination);
        backgroundMusicGain.gain.value = 0.3;
        playBackgroundMusic();
    } catch (e) {
        console.log('Web Audio API not supported');
    }
}

// Play background music (simple ambient tone)
function playBackgroundMusic() {
    if (!audioContext) return;
    
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(backgroundMusicGain);
    
    oscillator.frequency.value = 220;
    oscillator.type = 'sine';
    gainNode.gain.value = 0.05;
    
    oscillator.start();
    
    gainNode.gain.linearRampToValueAtTime(0.05, audioContext.currentTime + 2);
}

// Play correct answer sound
function playCorrectSound() {
    if (!audioContext) return;
    
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    oscillator.frequency.setValueAtTime(523.25, audioContext.currentTime);
    oscillator.frequency.setValueAtTime(659.25, audioContext.currentTime + 0.1);
    oscillator.frequency.setValueAtTime(783.99, audioContext.currentTime + 0.2);
    
    oscillator.type = 'sine';
    gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
    
    oscillator.start(audioContext.currentTime);
    oscillator.stop(audioContext.currentTime + 0.5);
}

// Play incorrect answer sound
function playIncorrectSound() {
    if (!audioContext) return;
    
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    oscillator.frequency.setValueAtTime(400, audioContext.currentTime);
    oscillator.frequency.setValueAtTime(300, audioContext.currentTime + 0.1);
    oscillator.frequency.setValueAtTime(200, audioContext.currentTime + 0.2);
    
    oscillator.type = 'sawtooth';
    gainNode.gain.setValueAtTime(0.2, audioContext.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.4);
    
    oscillator.start(audioContext.currentTime);
    oscillator.stop(audioContext.currentTime + 0.4);
}

// Play UI click sound
function playClickSound() {
    if (!audioContext) return;
    
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    
    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);
    
    oscillator.frequency.value = 800;
    oscillator.type = 'sine';
    gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
    
    oscillator.start(audioContext.currentTime);
    oscillator.stop(audioContext.currentTime + 0.1);
}

// DOM elements
let hazardCard, submitBtn, nextBtn, restartBtn, feedbackPanel;
let dropZones = [];
let currentDropZone = null;

// Initialize the application
function init() {
    hazardCard = document.getElementById('hazard-card');
    submitBtn = document.getElementById('submit-btn');
    nextBtn = document.getElementById('next-btn');
    restartBtn = document.getElementById('restart-btn');
    feedbackPanel = document.getElementById('feedback-panel');
    dropZones = document.querySelectorAll('.drop-zone');
    
    document.addEventListener('click', function initAudioOnce() {
        initAudio();
        document.removeEventListener('click', initAudioOnce);
    }, { once: true });
    
    setupEventListeners();
    loadScenario(0);
    setupInfoTooltip();
}

// Setup info icon tooltip
function setupInfoTooltip() {
    const infoIcon = document.getElementById('info-icon');
    const tooltip = document.getElementById('header-tooltip');
    
    infoIcon.addEventListener('click', () => {
        tooltip.classList.toggle('hidden');
        playClickSound();
    });
    
    document.addEventListener('click', (e) => {
        if (!infoIcon.contains(e.target) && !tooltip.contains(e.target)) {
            tooltip.classList.add('hidden');
        }
    });
}

// Setup all event listeners
function setupEventListeners() {
    hazardCard.addEventListener('dragstart', handleDragStart);
    hazardCard.addEventListener('dragend', handleDragEnd);
    
    dropZones.forEach(zone => {
        zone.addEventListener('dragover', handleDragOver);
        zone.addEventListener('dragleave', handleDragLeave);
        zone.addEventListener('drop', handleDrop);
        zone.addEventListener('touchstart', handleTouchStart);
        zone.addEventListener('click', handleZoneClick);
    });
    
    submitBtn.addEventListener('click', handleSubmit);
    nextBtn.addEventListener('click', handleNext);
    restartBtn.addEventListener('click', handleRestart);
    document.getElementById('play-again-btn').addEventListener('click', handleRestart);
    
    hazardCard.addEventListener('touchstart', handleCardTouchStart);
}

// Load a scenario
function loadScenario(index) {
    if (index >= scenarioData.length) {
        showResults();
        return;
    }
    
    const scenario = scenarioData[index];
    gameState.currentScenario = index;
    gameState.riskQuestionAnswered = false;
    
    document.getElementById('story-text').textContent = scenario.story;
    document.getElementById('scenario-image').textContent = scenario.emoji;
    document.querySelector('.hazard-text').textContent = scenario.hazard;
    
    updateProgress();
    resetUI();
}

// Update progress bar
function updateProgress() {
    const progress = ((gameState.currentScenario) / gameState.totalScenarios) * 100;
    document.getElementById('progress-bar').style.width = progress + '%';
    document.getElementById('progress-text').textContent = `Scenario ${gameState.currentScenario + 1} of ${gameState.totalScenarios}`;
}

// Reset UI for new scenario
function resetUI() {
    dropZones.forEach(zone => {
        zone.querySelector('.dropped-items').innerHTML = '';
        zone.classList.remove('drag-over');
        zone.style.border = '';
        zone.style.background = '';
    });
    
    hazardCard.style.display = 'flex';
    hazardCard.classList.remove('dragging');
    currentDropZone = null;
    
    submitBtn.disabled = true;
    submitBtn.classList.remove('hidden');
    nextBtn.classList.add('hidden');
    restartBtn.classList.add('hidden');
    
    feedbackPanel.classList.add('hidden');
    document.getElementById('risk-question-section').classList.add('hidden');
}

// Drag and drop handlers
function handleDragStart(e) {
    hazardCard.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/html', this.innerHTML);
}

function handleDragEnd(e) {
    hazardCard.classList.remove('dragging');
}

function handleDragOver(e) {
    if (e.preventDefault) {
        e.preventDefault();
    }
    e.dataTransfer.dropEffect = 'move';
    this.classList.add('drag-over');
    return false;
}

function handleDragLeave(e) {
    this.classList.remove('drag-over');
}

function handleDrop(e) {
    if (e.stopPropagation) {
        e.stopPropagation();
    }
    e.preventDefault();
    
    this.classList.remove('drag-over');
    placeCardInZone(this);
    playClickSound();
    
    return false;
}

// Touch support for mobile
let selectedForTouch = false;

function handleCardTouchStart(e) {
    selectedForTouch = true;
    hazardCard.style.border = '3px solid #fff';
    playClickSound();
}

function handleTouchStart(e) {
    e.preventDefault();
}

function handleZoneClick(e) {
    if (selectedForTouch && hazardCard.style.display !== 'none') {
        placeCardInZone(this);
        selectedForTouch = false;
        hazardCard.style.border = '3px solid transparent';
        playClickSound();
    }
}

// Place card in zone
function placeCardInZone(zone) {
    dropZones.forEach(z => {
        z.querySelector('.dropped-items').innerHTML = '';
    });
    
    const scenario = scenarioData[gameState.currentScenario];
    
    const droppedCard = document.createElement('div');
    droppedCard.className = 'dropped-card';
    droppedCard.innerHTML = `
        <span>${scenario.emoji}</span>
        <span>${scenario.hazard}</span>
    `;
    
    zone.querySelector('.dropped-items').appendChild(droppedCard);
    hazardCard.style.display = 'none';
    currentDropZone = zone.dataset.category;
    submitBtn.disabled = false;
}

// Handle submit
function handleSubmit() {
    playClickSound();
    
    const scenario = scenarioData[gameState.currentScenario];
    const isCorrect = currentDropZone === scenario.correctCategory;
    
    if (isCorrect) {
        gameState.score += scenario.points;
        gameState.correctAnswers++;
        updateScore();
        playCorrectSound();
        showFeedback(true, scenario);
    } else {
        playIncorrectSound();
        showFeedback(false, scenario);
    }
    
    submitBtn.classList.add('hidden');
    
    const selectedZone = document.querySelector(`[data-category="${currentDropZone}"]`);
    if (isCorrect) {
        selectedZone.classList.add('correct-answer');
    } else {
        selectedZone.classList.add('incorrect-answer');
    }
    
    if (!isCorrect) {
        const correctZone = document.querySelector(`[data-category="${scenario.correctCategory}"]`);
        setTimeout(() => {
            correctZone.style.border = '3px solid #10b981';
            correctZone.style.background = 'rgba(167, 243, 208, 0.5)';
        }, 500);
    }
    
    // Show risk reduction question after a brief delay
    setTimeout(() => {
        showRiskQuestion(scenario);
    }, 1000);
}

// Show risk reduction question
function showRiskQuestion(scenario) {
    const riskSection = document.getElementById('risk-question-section');
    const questionText = document.getElementById('risk-question-text');
    const optionsContainer = document.getElementById('risk-options');
    
    questionText.textContent = scenario.riskQuestion;
    optionsContainer.innerHTML = '';
    
    scenario.riskOptions.forEach((option, index) => {
        const optionBtn = document.createElement('div');
        optionBtn.className = 'risk-option';
        optionBtn.textContent = option.text;
        optionBtn.dataset.correct = option.correct;
        optionBtn.dataset.index = index;
        
        // MODIFIED: Updated click handler to remove explanation/feedback display
        optionBtn.addEventListener('click', () => handleRiskOptionClick(optionBtn, scenario));
        
        optionsContainer.appendChild(optionBtn);
    });
    
    riskSection.classList.remove('hidden');
}

// MODIFIED: Handle risk option click - removed explanation/feedback display
function handleRiskOptionClick(optionElement, scenario) {
    // Prevent multiple answers
    if (gameState.riskQuestionAnswered) return;
    
    playClickSound();
    
    const isCorrect = optionElement.dataset.correct === 'true';
    
    // Mark as answered
    gameState.riskQuestionAnswered = true;
    
    // Disable all options
    const allOptions = document.querySelectorAll('.risk-option');
    allOptions.forEach(opt => {
        opt.classList.add('disabled');
        // Highlight correct answer
        if (opt.dataset.correct === 'true') {
            opt.classList.add('correct');
        }
    });
    
    // Mark selected option and play appropriate sound
    if (isCorrect) {
        optionElement.classList.add('correct');
        playCorrectSound();
        // Award bonus points for correct risk reduction answer
        gameState.score += 50;
        updateScore();
    } else {
        optionElement.classList.add('incorrect');
        playIncorrectSound();
    }
    
    // MODIFIED: No feedback text displayed - just show next button after a brief delay
    setTimeout(() => {
        nextBtn.classList.remove('hidden');
    }, 500);
}

// Update score display
function updateScore() {
    document.getElementById('score-value').textContent = gameState.score;
}

// Show feedback
function showFeedback(isCorrect, scenario) {
    const feedbackIcon = document.getElementById('feedback-icon');
    const feedbackText = document.getElementById('feedback-text');
    const mitigationText = document.getElementById('mitigation-text');
    
    if (isCorrect) {
        feedbackIcon.textContent = '✅';
        feedbackText.textContent = 'Excellent! You correctly identified this hazard!';
        feedbackText.style.color = '#10b981';
    } else {
        feedbackIcon.textContent = '❌';
        feedbackText.textContent = `Not quite. This hazard belongs to the ${scenario.correctCategory.toUpperCase()} category.`;
        feedbackText.style.color = '#ef4444';
    }
    
    mitigationText.innerHTML = `<strong>Risk Mitigation:</strong> ${scenario.mitigation}`;
    
    feedbackPanel.classList.remove('hidden');
}

// Handle next scenario
function handleNext() {
    playClickSound();
    
    if (gameState.currentScenario < gameState.totalScenarios - 1) {
        loadScenario(gameState.currentScenario + 1);
    } else {
        showResults();
    }
}

// Show final results
function showResults() {
    const resultsScreen = document.getElementById('results-screen');
    const finalScore = document.getElementById('final-score');
    const performanceFeedback = document.getElementById('performance-feedback');
    const learningSummary = document.getElementById('learning-summary');
    
    const percentage = (gameState.correctAnswers / gameState.totalScenarios) * 100;
    
    finalScore.textContent = `${gameState.score} Points (${gameState.correctAnswers}/${gameState.totalScenarios} Correct)`;
    
    let feedback = '';
    if (percentage === 100) {
        feedback = '🌟 Outstanding! You\'re a P.E.E.P. master! You demonstrated excellent understanding of hazard classification and risk reduction strategies.';
    } else if (percentage >= 80) {
        feedback = '🎯 Great job! You have a strong grasp of the P.E.E.P. framework and risk management. Review the areas you missed to perfect your skills.';
    } else if (percentage >= 60) {
        feedback = '👍 Good effort! You\'re on the right track. Practice more to strengthen your hazard identification and risk reduction skills.';
    } else {
        feedback = '💪 Keep learning! Review the P.E.E.P. categories and risk reduction strategies, then try again. Every expert was once a beginner!';
    }
    performanceFeedback.textContent = feedback;
    
    learningSummary.innerHTML = `
        <strong>P.E.E.P. Framework Recap:</strong><br>
        👥 <strong>People:</strong> Human factors, behavior, skills, health<br>
        🔧 <strong>Equipment:</strong> Tools, gear, equipment condition<br>
        🌲 <strong>Environment:</strong> Weather, terrain, natural conditions<br>
        📋 <strong>Procedure:</strong> Planning, protocols, safety procedures<br><br>
        <strong>Key Risk Reduction Principles:</strong><br>
        • Always plan ahead and prepare thoroughly<br>
        • Conduct regular inspections and assessments<br>
        • Implement systematic checklists and procedures<br>
        • Provide proper training and practice opportunities<br>
        • Maintain redundant safety systems<br><br>
        Remember: Identifying hazards correctly and knowing how to reduce risks keeps everyone safe in outdoor activities!
    `;
    
    resultsScreen.classList.remove('hidden');
}

// Handle restart
function handleRestart() {
    playClickSound();
    
    gameState.currentScenario = 0;
    gameState.score = 0;
    gameState.correctAnswers = 0;
    gameState.riskQuestionAnswered = false;
    
    updateScore();
    document.getElementById('results-screen').classList.add('hidden');
    loadScenario(0);
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
} else {
    init();
}