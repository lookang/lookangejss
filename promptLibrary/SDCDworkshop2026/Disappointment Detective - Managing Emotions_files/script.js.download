// ===================================
// GAME STATE MANAGEMENT
// Tracks the current state of the learning experience
// ===================================
const gameState = {
    currentLevel: 0,
    score: 0,
    totalLevels: 5,
    timeLimit: 60,
    timeRemaining: 60,
    timerInterval: null,
    soundEnabled: true,
    completedLevels: []
};

// ===================================
// STORY AND LEARNING CONTENT
// Adventure narrative with disappointment scenarios
// Aligned with Singapore curriculum for SEL
// ===================================
const storyLevels = [
    {
        character: "😊",
        story: "Hi! I'm Detective Sam. Today, we're on a mission to help people manage their disappointments. Are you ready to be my partner?",
        situations: [],
        categories: []
    },
    {
        character: "⚽",
        story: "Level 1: Sports Day Surprise! Help sort these situations into healthy ways to handle disappointment.",
        situations: [
            { text: "Talk to a friend about how you feel", category: "healthy", emoji: "💬" },
            { text: "Blame others for losing", category: "unhealthy", emoji: "😠" },
