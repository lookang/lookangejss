// ============================================
// GAME STATE AND DATA MANAGEMENT
// ============================================

// Game state variables
let currentScene = 0;
let score = 0;
let progress = 0;
let musicEnabled = true;
let sfxEnabled = true;

// Audio context for generating simple tones (no external libraries)
let audioContext;
let backgroundMusicInterval;

// Adventure scenarios with bullying situations
const scenarios = [
    {
