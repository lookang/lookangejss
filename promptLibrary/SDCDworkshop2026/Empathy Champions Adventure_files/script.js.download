        ]
    },
    {
        id: 5,
        character: '😔',
        story: 'At lunch, you notice Alex sitting alone. Some kids are whispering and pointing at him. What\'s the best way to show empathy?',
        type: 'choice',
        choices: [
            { text: 'Invite Alex to sit with you and your friends', points: 10, empathy: true },
            { text: 'Join the kids who are whispering', points: 0, empathy: false },
