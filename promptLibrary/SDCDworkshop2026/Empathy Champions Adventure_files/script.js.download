    },
    {
        id: 4,
        character: '🎯',
        story: 'Excellent! Let\'s practice more. Sort these actions into empathetic or not empathetic responses.',
        type: 'sorting',
        cards: [
            { text: 'Listen when someone is upset', category: 'empathy', points: 5 },
