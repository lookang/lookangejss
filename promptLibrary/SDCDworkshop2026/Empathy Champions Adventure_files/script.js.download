        character: '🤔',
        story: 'Great choice! Now, let\'s learn about empathy. Sort these responses into "Empathy" or "Not Empathy".',
        type: 'sorting',
        cards: [
            { text: 'I understand how you feel', category: 'empathy', points: 5 },
            { text: 'That\'s your problem', category: 'not-empathy', points: 5 },
            { text: 'I\'m here to help you', category: 'empathy', points: 5 },
            { text: 'Stop crying, it\'s not a big deal', category: 'not-empathy', points: 5 },
            { text: 'Let me help you feel better', category: 'empathy', points: 5 },
            { text: 'Just ignore them', category: 'not-empathy', points: 5 }
        ]
    },
    {
        id: 3,
        character: '😰',
        story: 'During PE class, Maya drops her water bottle and everyone laughs. She looks embarrassed. How do you respond?',
        type: 'choice',
        choices: [
            { text: 'Help her pick it up and say "It happens to everyone"', points: 10, empathy: true },
