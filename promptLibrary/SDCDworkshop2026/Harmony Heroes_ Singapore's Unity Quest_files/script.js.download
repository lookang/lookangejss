// ============================================
// HARMONY HEROES: SINGAPORE'S UNITY QUEST
// Educational game about racial harmony in Singapore
// ============================================

// Global State Management
const gameState = {
    currentScene: 0,
    score: 0,
    choices: [],
    audioEnabled: true,
    timerInterval: null,
    timeRemaining: 30,
    selectedMatch: null,
    matchedPairs: []
};

// Audio Context for sound effects and music
const audioContext = {
    bgMusic: null,
    isMuted: false
};

// Game Scenes - Adventure storyline with choices
const scenes = [
    {
        type: 'narrative',
        avatar: '🧑',
        text: "Welcome, Harmony Hero! You're a new student at Unity Secondary School in Singapore. Your mission is to help build bridges between different communities. Are you ready?",
        choices: [
            { text: "Yes! Let's promote harmony!", next: 1 },
            { text: "Tell me more about Singapore's diversity", next: 1 }
        ],
        timer: 30
    },
    {
