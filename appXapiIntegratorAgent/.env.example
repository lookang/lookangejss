PORT=3000
# Required for AI Agent mode (Gemini).
# This server-side key is used for requests from allowed domains (e.g. moe.edu.sg)
# or when a user is signed in with a verified @moe.edu.sg Google account.
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2
ALLOWED_DOMAINS=moe.edu.sg
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
AUTH_SESSION_TTL_HOURS=24
NODE_ENV=development
UPLOAD_DIR=./uploads
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE=52428800
