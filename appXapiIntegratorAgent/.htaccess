Options -Indexes

# Never serve local configuration, editor, or VCS metadata.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Keep development and package-management metadata out of public responses.
<FilesMatch "^(package(-lock)?\.json|npm-shrinkwrap\.json|composer\.(json|lock)|behat\.yml\.dist|\.travis\.yml)$">
    Require all denied
</FilesMatch>

# Block common local-only files if they are accidentally copied here.
<FilesMatch "^(Thumbs\.db|\.DS_Store|npm-debug\.log.*|yarn-debug\.log.*|yarn-error\.log.*)$">
    Require all denied
</FilesMatch>
