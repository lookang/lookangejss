<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public void drag2 () {
 PY[1]=PX[1]=zero;
 c1=Math.atan2(PY[0],PX[0]);
 c3=Math.atan2(PY[2],PX[2]);
 c2=(c3-c1)/2.;
 c2a=c2*2/a2c;
 if(c2a<40){
   c2a=40;
   c2=c2a*a2c/2;
 }
 if(c1<0)c1=0;
 c1a=c1/a2c;
 drag();
}
]]></Code>

