<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public void dragcta(){
c1=c1a*a2c;
if(c2a>90-c1a/2)c2a=90-c1a/2.;
c1max=180-2*c2a;
c2=c2a*a2c/2.;
drag();
}
public void drag () {
zero=0.;
if(-mg<range/20)mg=-range/20;
else if(-mg>range/2)mg=-range/2;
c3=c1+2*c2;

D=Math.sqrt(-mg*4/range)*D0;
R=D/2;
d=R/Math.sin(c2);
w=d*Math.cos(c2);
cs1=Math.cos(c1);
sc1=Math.sin(c1);
cs3=Math.cos(c3);
sc3=Math.sin(c3);
x=d*Math.cos(c1+c2);
y=d*Math.sin(c1+c2);
PX[0]=L*cs1;
PY[0]=L*sc1;
PX[2]=L*cs3;
PY[2]=L*sc3;
fl=mg*sc1/(sc1*cs3-cs1*sc3); Math.sin(2*c2);
if(c1a!=0)fr=fl*sc3/sc1;
else fr=-mg;
xl=w*cs3;
yl=w*sc3;
xr=w*cs1;
yr=w*sc1;
frx=-fr*sc1;
fry=fr*cs1;
flx=fl*sc3;
fly=-fl*cs3;
frvx=(x-xr)/T;
frvy=(y+mg-yr)/T;
flvx=(x+frx-xl)/T;
flvy=(y+mg+fry-yl)/T;

c1x=tr*cs1;
c1y=tr*sc1;
c2x=tr*cs3;
c2y=tr*sc3;
}
]]></Code>

</Content>
