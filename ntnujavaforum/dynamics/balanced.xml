<Name>drag</Name>
<Active>true</Active>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public void drag () {
cta=Math.PI/180.*ctaa;
sc=Math.sin(cta);
cs=Math.cos(cta);
x1=l1*cs;
x2=l2*cs;
if(x1>L2*cs)x1=L2*cs;
if(x2<-L2*cs)x2=-L2*cs;
y=-x*sc/cs;
y1=x1*sc/cs+y;
y2=x2*sc/cs+y;
minx=-0.75*L2;
if(minx<x2+s2)minx=x2+s2;
maxx=0.75*L2;
if(maxx>x1-s1)maxx=x1-s1;

s1=mscale*Math.sqrt(m1);
m2=(l1-x)*m1/(x-l2);
s2=mscale*Math.sqrt(m2);
}
]]></Code>

</Content>
