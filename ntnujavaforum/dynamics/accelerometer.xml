<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
double dx=2./(n-1),cst;
for(int i=1;i<n+1;i++){
 px[i]=-1+(i-1)*dx;
 py[i]=c*px[i]*px[i];
 cst=r/Math.sqrt(1+4*c*c*px[i]*px[i]);
 px[i]+=2*c*px[i]*cst;
 py[i]-=cst;
}
px[0]=px[1];py[0]=ymin;
px[n+1]=px[n];py[n+1]=ymin;
t=0;
x=0;
vx=0.;
]]></Code>

