<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public void dragl () {
 if(xl<-L2)xl=-L2;
 else if(xl+w2>L2)xl=L2-w2;
 xr=xl+w2;
 hx=xr-size;
}
public void dragr () {
 if(xr>L2)xr=L2;
 else if(xr-w2<-L2)xr=-L2+w2;
 xl=xr-w2;
 hx=xr-size;
}
public void dragh(){
 if(hx+size>L2)hx=L2-size;
 else if(hx+size-w2<-L2)hx=-L2+w2-size;
 xr=hx+size;
 xl=xr-w2;
}
]]></Code>

</Content>
