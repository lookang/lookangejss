<Osejs.Model.Library.Page>
<Type>LIBRARY_EDITOR</Type>
<Name>dragbox</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public void dragbox () {
 baseh=ymax+basey;
 hy=basey+waterh-depth;
 if(basex< 0.8*xmin)basex=0.8*xmin;
 waterw=basex-xmin;
 bx[0]=bx[1]=xmin-basex;
}
public void draghole () {
 if(hy>basey+waterh-size2)hy=basey+waterh-size2;
 else if(hy<basey+size2)hy=basey+size2;
 depth=waterh-(hy-basey);
}

]]></Code>

</Content>
