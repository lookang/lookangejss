<Osejs.Model.Constraints.Page>
<Type>CODE_EDITOR</Type>
<Name>Cons Page</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
double delta,t2;
zero=0.;
basex=xmin+waterw;
depth=waterh-(hy-basey);
h=hy+ymax;
tmax=Math.sqrt(2*h/g);
delta=tmax/n;
if(depth>0)vx=Math.sqrt(2*g*depth);
else {
 vx=0.;
 waterh=hy-basey;
 if(_isPlaying())playpause();
}
for(int i=0;i<n;i++){
  t2=i*delta;
  x[i]=basex+vx*t2;
  y[i]=hy-g*t2*t2/2;
}

]]></Code>

</Content>
</Osejs.Model.Constraints.Page>
</Osejs.Model.Constraints>
