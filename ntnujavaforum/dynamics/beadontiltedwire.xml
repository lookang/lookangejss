<Type>LIBRARY_EDITOR</Type>
<Name>getF</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public double getFx (double dx,double dy) {
 r=Math.sqrt(dx*dx+dy*dy);
 f=-k*(1-L/r)*(dx+slope*dy)*Math.cos(c)-m*g*Math.sin(c);
 return f*Math.cos(c);
}
public double getFy (double dx,double dy) {
 return f*Math.sin(c);
}
public void drag(){
y=slope*(x-xmin)+y1;
vx=vy=0.;
ax=getFx(x,y-y0)/m;
ay=getFy(x,y-y0)/m;
}
]]></Code>

