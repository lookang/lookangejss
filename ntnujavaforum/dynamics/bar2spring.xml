<Active>true</Active>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
double L1,L2;
public double calf (double x,double y,double cta) {
 x1=x-w2*Math.cos(cta);
 y1=y-w2*Math.sin(cta);
 x2=x+w2*Math.cos(cta);
 y2=y+w2*Math.sin(cta);
 L1=Math.sqrt((x1-xa)*(x1-xa)+(y1-ya)*(y1-ya));
 f1=-k1*(L10-L1);
 L2=Math.sqrt((x2-xb)*(x2-xb)+(y2-ya)*(y2-ya));
 f2=-k2*(L20-L2);
 f1x=f1*(xa-x1)/L1; f1y=f1*(ya-y1)/L1;
 f2x=f2*(xb-x2)/L2; f2y=f2*(ya-y2)/L2;
 return 0.;
}
]]></Code>

</Content>
