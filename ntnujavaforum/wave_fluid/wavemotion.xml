<Name>add</Name>
<Active>true</Active>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
int id;
public void add(double x){
 if(x>xl-wlength && x<xr){
   for(int i=0;i<n;i++){
    id=(int)((x-xl)/dx)+i;
    if(id>-1 && id<n3) Y[id]+=YP[i];
  }
 }
}
]]></Code>

