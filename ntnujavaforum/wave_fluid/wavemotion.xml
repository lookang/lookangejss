<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
double k=Math.PI*2/wlength;
dx=wlength/(n-1);
for(int i=0;i<n;i++){
 XP[i]=i*dx;
 YP[i]=wheight*Math.sin(k*XP[i]);
}
clr=new java.awt.Color(0,0,0);
dx=(xr-xl)/(n3-1);
for(int i=0;i<n3;i++){
 X[i]=i*dx;
}

]]></Code>

