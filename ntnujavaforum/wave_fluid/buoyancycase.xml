public String dvalue (double v) {
 if(v>0)dv=0.5;
 else if(v<0)dv=-0.5;
 else dv=0.;
 s=(int)(v*100+dv)/10.+"";
 //if(Math.abs((int)(v*10+dv)-v*10)<0.09)s+="0";
 return s;
}
